# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ─────────────────────────────────────────────────────────────
# Supabase  (Project Settings → API in the Supabase dashboard)
# ─────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser (RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. SERVER ONLY. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# Origin the app is served from. Local dev runs on port 3001.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# AI  (Vercel AI Gateway — https://vercel.com/dashboard → AI Gateway → API Keys)
# ─────────────────────────────────────────────────────────────
# Used by @ai-sdk/gateway for all card generation, grading, distractors, kata, etc.
# If you run the app with `vercel dev` (or after `vercel env pull`), a short-lived
# VERCEL_OIDC_TOKEN is injected automatically and this key is optional.
AI_GATEWAY_API_KEY=

# ─────────────────────────────────────────────────────────────
# Vercel Sandbox  (kata code execution — optional; kata runs fail without it)
# ─────────────────────────────────────────────────────────────
# Easiest path: run `vercel link` then `vercel env pull`, which provides an
# auto-refreshed VERCEL_OIDC_TOKEN. Alternatively set an access token + IDs:
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# ─────────────────────────────────────────────────────────────
# Auto-provided by Vercel in deployed environments — do not set locally:
#   VERCEL_URL, NEXT_PUBLIC_VERCEL_URL, VERCEL_OIDC_TOKEN
# ─────────────────────────────────────────────────────────────
